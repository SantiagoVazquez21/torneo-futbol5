<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>_2doISFT225_SantiagoVazquez_ProyectoTorneoFutbol5</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="26.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le indica a Visual Studio que son formularios, para que los abra en el diseñador. -->
    <Compile Update="IGU\FormPrincipal.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="IGU\FormJugador.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="IGU\FormListado.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="IGU\FormEquipo.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="IGU\GrillaJugadores.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- Se copia junto al .exe para que la app lo encuentre al ejecutarse. -->
    <None Update="conexion.local.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>